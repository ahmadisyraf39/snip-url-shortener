{
  "bindings": [
    {
      "authLevel": "anonymous",
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "methods": ["post"],
      "route": "links"
    },
    {
      "type": "http",
      "direction": "out",
      "name": "res"
    },
    {
      "name": "newLink",
      "direction": "out",
